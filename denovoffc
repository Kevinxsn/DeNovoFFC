#!/usr/bin/env bash
# DeNovoFFC entry point.
#
# Uses $DENOVOFFC_PYTHON if set, else the first interpreter that can import
# pandas.  The pipeline needs numpy / pandas / scipy / openpyxl.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

pick_python() {
  if [[ -n "${DENOVOFFC_PYTHON:-}" ]]; then echo "$DENOVOFFC_PYTHON"; return; fi
  for p in python3 python; do
    if command -v "$p" >/dev/null 2>&1 && "$p" -c "import pandas" 2>/dev/null; then
      command -v "$p"; return
    fi
  done
  echo "denovoffc: no Python with pandas found. Set \$DENOVOFFC_PYTHON." >&2
  exit 1
}

PY="$(pick_python)"
exec "$PY" -c "import sys; sys.path.insert(0, '$HERE'); from pipeline.cli import main; sys.exit(main())" "$@"
